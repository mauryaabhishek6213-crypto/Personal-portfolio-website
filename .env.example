# Environment Configuration Template
# Copy this file to .env and configure real production secrets.
# NEVER commit real .env files with credentials to public version control.

# Application Server Port
PORT=3000

# Server Environment (development | production)
NODE_ENV=production

# Administrator Authentication Credentials
ADMIN_USERNAME=abhishek_admin
ADMIN_PASSWORD_SALT=your_random_cryptographic_salt_hex_here
ADMIN_PASSWORD_HASH=your_scrypt_password_hash_hex_here

# Session Configuration
SESSION_SECRET=your_32_character_random_session_secret_key_here
